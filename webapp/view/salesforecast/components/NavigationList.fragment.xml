    icon="{icon}"
    enabled="{enabled}"
    expanded="{expanded}"
    items="{path: 'items', templateShareable:true}"
    key="{key}"
>
    <!-- TODO: Todos los componentes (clases) deben de tener un ID unico cuando flex es "true"  -->
    <!--  hace falta averiguar como incluir un ID unico al NavigationListItem cuando se crea la lista de items-->
    <!--  de momento ignorar el error. -->
    <NavigationListItem
        text="{title}"
        key="{key}"
        enabled="{enabled}"
    />
</NavigationListItem>
